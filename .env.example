# ISP Monitor — environment variables
# Copy to .env and fill in before the first `docker compose up -d`.

# Timezone, used by Speedtest Tracker and SmokePing for scheduling and labels.
TZ=America/New_York

# Speedtest Tracker application key, 32 random bytes base64 encoded. Generate:
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=base64:generate-with-the-command-above

# Cron expression for scheduled speed tests. Default is every three hours.
# Ookla rate-limits aggressive schedules and each test moves real data, so
# think before going below hourly.
SPEEDTEST_SCHEDULE="0 */3 * * *"

# Speedtest Tracker admin login. These are read ONLY by the first-run migration
# that seeds the user — set them before you start the stack the first time.
# Leaving them blank gives you admin@example.com / password.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-before-first-start

# Grafana admin login. Unlike the above, Grafana applies these on every start.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
